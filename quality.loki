# frozen_string_literal: true
# Quality gate tasks — imported by .loki

require "shellwords"

class Tasks
  # One process for every test/test_*.rb, so SimpleCov sees the whole suite.
  TEST_LOADER = %q(Dir["test/test_*.rb"].each { |f| require File.expand_path(f) }).shellescape.freeze

  desc "Run the test suite"
  def test_check = run_gate(:test, "Tests", "bundle exec ruby -Ilib:test -e #{TEST_LOADER}", summary: /\d+ runs,/)

  desc "Run the test suite with verbose output"
  def test_verbose
    sh "bundle exec ruby -Ilib:test -e #{TEST_LOADER} -- -v"
  end

  desc "Run the test suite in forked worker processes (experimental)"
  option :workers, aliases: "-w", type: :numeric, desc: "Worker processes (default: CPU count, at most 8)"
  option :times, type: :boolean, default: false, desc: "Print each test's name and time"
  def parallel_test
    flags = []
    flags << "--workers #{options.workers}" if options.workers
    flags << "-v" if options.times?
    sh ["bundle exec ruby -Ilib:test test/parallel_runner.rb", *flags].join(" ")
  end

  # Every *_check task, in the order the summary lists them.
  def self.quality_checks = all_commands.keys.grep(/_check\z/).sort.map(&:to_sym)

  desc "Run every *_check quality gate task in parallel"
  # A Proc defers resolution to validate_deps!, after every .loki file has
  # loaded — so a *_check task from another file (e.g. quality_rails.loki's
  # brakeman_check) is picked up too, with no need to redeclare anything here.
  # quality_board runs first so every gate has its row before any starts.
  depends_on -> { [:quality_board, quality_checks] }
  def quality
    results = dep_results.except(:quality_board).sort.to_h { |name, status| [quality_gate_label(name.to_s), status] }

    print_quality_summary(results, rows: QUALITY_BOARD.empty?)
  end

  # Gate task name => its spinner row; empty unless quality_board drew one.
  QUALITY_BOARD = {}

  desc "Draw the live quality board: one spinner row per gate", hide: true
  def quality_board
    return unless $stdout.tty?

    require "io/console"
    require "tty-spinner"

    print_quality_header
    labels = self.class.quality_checks.to_h { |check| [check, quality_gate_label(check.to_s)] }
    width  = labels.values.map(&:length).max
    board  = TTY::Spinner::Multi.new(output: $stdout, hide_cursor: true, success_mark: "",
                                     frames: %w[●··· ·●·· ··●· ···● ··●· ·●··])
    labels.each do |check, label|
      row = board.register("  [:spinner:badge] #{label.ljust(width)}  :note")
      row.update(badge: "", note: "")
      row.auto_spin
      QUALITY_BOARD[check] = row
    end
  end

  desc "Check code style with RuboCop"
  def rubocop_check
    run_gate(:rubocop, "RuboCop", "RUBOCOP_CACHE_ROOT=tmp/rubocop_cache bundle exec rubocop", summary: /files inspected/)
  end

  desc "Auto-correct RuboCop offenses"
  def rubocop_fix
    sh "RUBOCOP_CACHE_ROOT=tmp/rubocop_cache bundle exec rubocop -a"
  end

  FLOG_WARN = 20.0
  FLOG_FAIL = 50.0
  FLAY_MASS = 150

  desc "Check code complexity with Flog (warn >=20, fail >=50)"
  def flog_check
    run_gate(:flog, "Flog", "bundle exec flog -a lib",
             status:  ->(output) { flog_scores(output).any? { |s| s >= FLOG_FAIL } ? :fail : :pass },
             summary: lambda { |output, _result|
               scores = flog_scores(output)
               "#{scores.count { |s| s >= FLOG_FAIL }} failure(s), " \
                 "#{scores.count { |s| s >= FLOG_WARN && s < FLOG_FAIL }} warning(s)"
             })
  end

  desc "Check for structural code duplication with Flay (mass >= 150)"
  def flay_check
    run_gate(:flay, "Flay", "bundle exec flay --mass #{FLAY_MASS} --timeout 60 lib",
             status:  ->(output) { output.match?(/^\d+\) /) ? :fail : :pass },
             summary: lambda { |output, _result|
               "#{output.lines.grep(/^\d+\) /).size} duplication pattern(s) found (mass >= #{FLAY_MASS})"
             })
  end

  desc "Report code smells with Reek (advisory: warns, never fails)"
  def reek_check = run_gate(:reek, "Reek", "bundle exec reek lib", summary: /total warnings?/, on_fail: :warn)

  desc "Check spelling with typos"
  def typos_check
    return skip_typos unless command_available?("typos")

    run_gate(:typos, "Typos", "typos", summary: lambda { |output, result|
      result == :pass ? "no typos found" : "#{output.lines.count { |l| l.start_with?("error:") }} typo(s) found"
    })
  end

  desc "Auto-correct typos"
  def typos_fix
    return skip_typos unless command_available?("typos")

    sh "typos -w"
  end

  desc "Check ERB templates for style and safety issues with ERBLint"
  def erb_lint_check
    return skip_erb_lint if Dir.glob("**/*.erb").empty?

    run_gate(:erb_lint, "ERBLint", "bundle exec erb_lint --lint-all --enable-all-linters",
             summary: /error\(s\)|no errors were found/i)
  end

  desc "Check for performance suggestions with Fasterer"
  def fasterer_check
    run_gate(:fasterer, "Fasterer", "bundle exec fasterer lib", summary: /files? inspected/, on_fail: :warn)
  end

  desc "Check Gemfile.lock for known vulnerabilities with bundler-audit"
  def bundler_audit_check
    run_gate(:bundler_audit, "Bundler Audit", "bundle exec bundle-audit check --update", summary: /vulnerabilit/i)
  end

  desc "Check architecture boundaries with ArchSpec"
  def archspec_check
    return skip_archspec unless command_available?("archspec") && File.exist?("Archspec.rb")

    run_gate(:archspec, "ArchSpec", "archspec check", summary: /architecture violations? found|ArchSpec passed/i)
  end

  # Curated display labels for the *_check tasks defined in this file. A
  # *_check task from elsewhere (e.g. quality_rails.loki's brakeman_check,
  # loaded automatically once Rails is defined) isn't listed here — it just
  # falls back to a titleized version of its own name in quality_gate_label.
  QUALITY_GATE_LABELS = {
    "test_check"     => "Tests + Coverage",
    "rubocop_check"  => "RuboCop",
    "flog_check"     => "Flog Complexity",
    "flay_check"     => "Flay Duplication",
    "reek_check"     => "Reek Smells",
    "erb_lint_check" => "ERBLint",
    "archspec_check" => "ArchSpec",
  }.freeze

  no_commands do
    # Runs +command+ as one gate: saves its output (stdout and stderr, color
    # codes removed) to <name>_output.txt, prints "Label: summary" and
    # returns +on_fail+ when the command exits non-zero. Otherwise it
    # returns :pass, or what +status+ (a callable given the output) says,
    # for a tool whose exit status ignores its findings.
    def run_gate(name, label, command, summary:, on_fail: :fail, status: nil)
      output = `#{command} 2>&1`.gsub(/\e\[[\d;]*m/, "")
      result = $?.success? ? status&.call(output) || :pass : on_fail
      report_gate(name, label, output, result, summary)
    end

    # Writes +output+ to <name>_output.txt, reports the gate's one-line
    # summary and returns +result+.
    def report_gate(name, label, output, result, summary)
      file = "#{name}_output.txt"
      File.write(file, output)
      finish_gate(name, label, result, "#{gate_summary(output, result, summary)} (see #{file})")
    end

    # Settles gate +name+ (:rubocop for rubocop_check): its row on the live
    # board gets the badge and +note+, or, with no board, prints
    # "Label: note". Returns +result+.
    def finish_gate(name, label, result, note)
      row = QUALITY_BOARD[:"#{name}_check"]
      if row
        row.update(badge: status_badge(result), note: fit_note(note, row.message))
        row.success
      else
        puts "#{label}: #{note}"
      end
      result
    end

    # +note+ cut to fit on one terminal line after +pattern+'s visible text.
    # A wrapped row would throw off the board's cursor moves.
    def fit_note(note, pattern, columns = $stdout.winsize[1].nonzero? || 80)
      room = columns - pattern.sub(":spinner:badge", "PASS").sub(":note", "").length - 1
      note.length <= room ? note : "#{note[0, [room - 1, 0].max]}…"
    end

    # The colored badge text for a status, e.g. PASS in green.
    def status_badge(status)
      text, code = STATUS_BADGES.fetch(status)
      colorize(code, text)
    end

    def colorize(code, text) = "\e[#{code}m#{text}\e[0m"

    # The summary for a gate's output. +summary+ is a Regexp, matched against
    # the last line that fits (the result's name when none does), or a
    # callable given the output and the result.
    def gate_summary(output, result, summary)
      return summary.call(output, result) if summary.respond_to?(:call)

      output.lines.reverse.find { |l| l.match?(summary) }&.strip || result.to_s
    end

    # The per-method scores in `flog -a` output, skipping the total, the
    # average and each file's top-level code (the "#none" entries).
    def flog_scores(output)
      output.scan(/^\s*(\d+\.\d+): (\S*(?:#|::)\S*)/).filter_map do |score, name|
        score.to_f unless name.end_with?("#none")
      end
    end

    # true if +name+ resolves to an executable file somewhere on PATH.
    def command_available?(name)
      ENV.fetch("PATH", "").split(File::PATH_SEPARATOR).any? do |dir|
        File.executable?(File.join(dir, name))
      end
    end

    def quality_gate_label(check_name)
      QUALITY_GATE_LABELS.fetch(check_name) do
        check_name.delete_suffix("_check").split("_").map(&:capitalize).join(" ")
      end
    end

    def skip_typos
      finish_gate(:typos, "Typos", :skip,
                  "SKIPPED — `typos` command not found. Install it with `brew install typos-cli`.")
    end

    def skip_erb_lint
      finish_gate(:erb_lint, "ERBLint", :skip, "SKIPPED — no .erb files found.")
    end

    def skip_archspec
      reason = command_available?("archspec") ? "no Archspec.rb found" : "`archspec` command not found"
      finish_gate(:archspec, "ArchSpec", :skip,
                  "SKIPPED — #{reason}. Install it with `gem install archspec` and run `archspec init` to generate one.")
    end

    # Status badges. Only :fail is blocking (aborts the quality task);
    # :skip (a required tool isn't installed) and :warn (the check ran but
    # has non-blocking suggestions, e.g. a performance-hint gate) are not.
    STATUS_BADGES = {
      pass: ["PASS", 32], # green
      fail: ["FAIL", 31], # red
      warn: ["WARN", 33], # yellow
      skip: ["SKIP", 36], # cyan
    }.freeze

    def print_quality_header
      puts <<~HEADER

        #{"=" * 60}
        Quality Gate Summary
        #{"=" * 60}
      HEADER
    end

    # Colorized status badges plus a pass/fail/warn/skip tally; aborts only
    # if any gate failed — skip and warn are informational, not blocking.
    # +rows+ is false when the live board already showed the header and a
    # row per gate.
    def print_quality_summary(results, rows: true)
      if rows
        print_quality_header
        width = results.keys.map(&:length).max
        results.each { |label, status| puts "  [#{status_badge(status)}] #{label.ljust(width)}" }
      end

      counts = results.values.tally
      failed = counts[:fail] || 0
      tally  = STATUS_BADGES.keys.filter_map { |s| "#{counts[s]} #{s}" if counts[s]&.positive? }.join(", ")
      puts <<~FOOTER
        #{"-" * 60}
          #{colorize(failed.zero? ? 32 : 31, tally)}
        #{"=" * 60}
      FOOTER

      abort "\n#{colorize(31, "Quality gate failed.")}" unless failed.zero?
      puts "\n#{colorize(32, "All quality gates passed.")}"
    end
  end
end
