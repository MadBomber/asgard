# frozen_string_literal: true
# Gem lifecycle tasks — imported by .loki

class Tasks
  desc "Open IRB console with the gem loaded"
  def console
    if File.exist?("bin/console")
      sh "bin/console"
    else
      sh "bundle exec irb -Ilib -r #{@@project}"
    end
  end

  desc "Build the gem package"
  depends_on :quality
  def build
    sh "mkdir -p pkg"
    sh "gem build #{@@project}.gemspec"
    sh "mv #{@@project}-#{project_version}.gem pkg/"
  end

  desc "Build and install gem locally"
  depends_on :build
  def install
    sh "gem install pkg/#{@@project}-#{project_version}.gem"
  end

  desc "Release gem to RubyGems (builds behind the quality gate first)"
  option :yes, aliases: "-y", type: :boolean, default: false, desc: "Skip confirmation prompt"
  depends_on :build
  def release
    tag      = "v#{project_version}"
    gem_file = "pkg/#{@@project}-#{project_version}.gem"

    unless options.yes?
      print "Release #{@@project} v#{project_version} to RubyGems? [y/N] "
      $stdout.flush
      return puts "Aborted." unless $stdin.gets.to_s.strip.downcase == "y" # nil at end of input
    end

    abort "Working directory is not clean — commit or stash changes first." unless `git status --porcelain`.strip.empty?
    abort "Tag #{tag} already exists." unless `git tag -l #{tag}`.strip.empty?

    sh "git tag #{tag}"
    sh "git push origin #{tag}"
    sh "gem push #{gem_file}"
  end
end
