#!/usr/bin/env ruby
# frozen_string_literal: true

# --version needs nothing but the constant, so answer it before loading
# Thor and the rest of the gem.
if ARGV.include?("--version")
  require_relative "../lib/asgard/version"
  puts Asgard::VERSION
  exit
end

require_relative "../lib/asgard"
Asgard.run!(ARGV)
