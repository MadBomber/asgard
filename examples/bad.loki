# frozen_string_literal: true
# What goes wrong when parallel dependencies try to hand results to the
# task that depends on them through an instance variable.
#
# Each task in one parallel group runs on its own copy of the task object.
# An @ivar a parallel dependency sets lives on that copy, so the dependent
# task never sees it. Sequential dependencies happen to share one object,
# which is why this surprises people when `depends_on :a, :b` later becomes
# `depends_on [:a, :b]`.
#
# The right channel is the task's return value, read with dep_result
# (one dependency) or dep_results (all of them).
#
# Run with:
#   asgard bad_race

BAD_RACE_REPS = 1000

class Tasks
  desc "Count to BAD_RACE_REPS (parallel worker)"
  def racer_1 = count_hits

  desc "Count to BAD_RACE_REPS (parallel worker)"
  def racer_2 = count_hits

  desc "Count to BAD_RACE_REPS (parallel worker)"
  def racer_3 = count_hits

  desc "Count to BAD_RACE_REPS (parallel worker)"
  def racer_4 = count_hits

  depends_on [:racer_1, :racer_2, :racer_3, :racer_4]
  desc "Compare @hits with dep_result after a parallel stage"
  def bad_race
    puts "@hits after the parallel stage: #{@hits.inspect}"
    puts "dep_result(:racer_1): #{dep_result(:racer_1)}"
    puts "sum of dep_results: #{dep_results.values.sum}"
  end

  no_commands do
    # Sets @hits on this task's own copy and returns the count, which is
    # what dep_result hands to the dependent task.
    def count_hits
      @hits = 0
      BAD_RACE_REPS.times { @hits += 1 }
      @hits
    end
  end
end
