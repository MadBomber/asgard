#!/usr/bin/env ruby
# frozen_string_literal: true

# --version needs nothing but the constant, so answer it before loading
# Thor and the rest of the gem. Only before the task name, as in
# Asgard.leading_flag?: after it, --version is the task's own argument.
if ARGV.take_while { |word| word.start_with?("-") }.include?("--version")
  require_relative "../lib/asgard/version"
  puts Asgard::VERSION
  exit
end

require_relative "../lib/asgard"
Asgard.run!(ARGV)
