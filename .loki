# frozen_string_literal: true
# Asgard gem's own task file.
# Task is pre-defined by the gem — just reopen it to add tasks.

# The shared task files (quality gates, git, docs, gem lifecycle) live in the
# sibling `dev` repository (https://github.com/MadBomber/dev), cloned beside
# this one; import_up finds its .loki in a parent directory.
abort "asgard: dev/.loki not found; clone https://github.com/MadBomber/dev beside asgard" unless import_up "dev/.loki"

# Imported after dev/.loki, so what it defines replaces the shared task of
# the same name: asgard runs its suite with its own test runner.
import "test_check.loki"

class Tasks
  @@project      ||= "asgard".freeze
  @@project_desc ||= "CLI-task runner"

  # Dogfood: `asgard watcher start` reruns the tests whenever a Ruby file changes.
  watch :test_check, paths: %w[lib test], only: /\.rb\z/

  helper(:project_version) do
    @@project_version ||= loki_up.dirname.join("lib/#{@@project}/version.rb").read.match(/VERSION\s*=\s*"([^"]+)"/)[1].freeze
  end

  default_task :quality

  header <<~HEAD
    Project:  #{@@project} (v#{project_version}) - #{@@project_desc}
    Root Dir: #{loki_up.parent}
    Default task: #{default_task}
  HEAD
end
